    <string name="onboarding_slide_1_title">Tap &amp; Inspect Your Transit Card</string>
    <string name="onboarding_slide_1_body">Hold your MRT Pass or Rapid Pass behind your phone to inspect card status locally. No internet or login needed.</string>
